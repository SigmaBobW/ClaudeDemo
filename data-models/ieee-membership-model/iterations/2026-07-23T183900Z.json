{
  "name": "IEEE Membership Model",
  "description": "IEEE memberships joined to Active contacts. Primary fact: t_memberships_subscriptions_data (dp_it_views). Left-outer join to contacts filtered to status_description = 'Active' on contact_id = customer_number.",
  "schemaVersion": 1,
  "folderId": "03308095-2e57-4967-9127-9b31e83a6634",
  "pages": [
    {
      "id": "page-model",
      "name": "Model",
      "elements": [
        {
          "id": "memberships",
          "kind": "table",
          "name": "Memberships",
          "source": {
            "kind": "warehouse-table",
            "connectionId": "41e2542e-133f-4d7d-aaa5-5b5416a23045",
            "path": ["dp_it_catalog", "dp_it_views", "t_memberships_subscriptions_data"]
          },
          "columns": []
        },
        {
          "id": "active-contacts",
          "kind": "table",
          "name": "Active Contacts",
          "source": {
            "kind": "sql",
            "connectionId": "41e2542e-133f-4d7d-aaa5-5b5416a23045",
            "statement": "SELECT * FROM dp_it_catalog.dp_it.contact WHERE status_description = 'Active'"
          },
          "columns": []
        },
        {
          "id": "membership-detail",
          "kind": "table",
          "name": "Membership Detail",
          "source": {
            "kind": "join",
            "name": "Membership Detail",
            "primarySource": { "kind": "table", "elementId": "memberships" },
            "joins": [
              {
                "left": { "kind": "table", "elementId": "memberships" },
                "right": { "kind": "table", "elementId": "active-contacts" },
                "columns": [
                  { "left": "[contact_id]", "right": "[customer_number]", "op": "=" }
                ],
                "joinType": "left-outer",
                "name": "Active Contacts"
              }
            ]
          },
          "columns": []
        }
      ]
    }
  ]
}
